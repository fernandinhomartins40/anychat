# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Operating company (hosted SaaS). Shown on /terms, /privacy, /data-deletion,
# /meta-review and the landing footer; Meta checks it against the business
# verification. Unset values render as "[preencher ...]" on purpose.
# NEXT_PUBLIC_* values are inlined at build time: rebuild after changing them.
# Leave empty until the real data exists; never ship made-up values.
# Example: NEXT_PUBLIC_COMPANY_NAME="Sua Empresa Tecnologia Ltda."
NEXT_PUBLIC_COMPANY_NAME=
# Example: NEXT_PUBLIC_COMPANY_CNPJ=00.000.000/0001-00
NEXT_PUBLIC_COMPANY_CNPJ=
# Contact and data protection officer (encarregado) address, e.g. privacidade@seudominio.com.br
NEXT_PUBLIC_COMPANY_EMAIL=
# Example: NEXT_PUBLIC_COMPANY_ADDRESS="Rua Exemplo, 123, Sala 4, Sao Paulo - SP, 01000-000"
NEXT_PUBLIC_COMPANY_ADDRESS=

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Billing (optional — hosted AnyChat only). Leave STRIPE_SECRET_KEY unset to
# self-host: every workspace is unlimited and all billing UI is hidden.
# Setup steps: docs/billing.md
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring monthly Prices in BRL, one per paid plan
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_AGENCY=price_...
# Optional display labels; when unset the amount is read from the Stripe Price
# NEXT_PUBLIC_PRICE_PRO_LABEL="R$ XX/mês"
# NEXT_PUBLIC_PRICE_AGENCY_LABEL="R$ XXX/mês"
